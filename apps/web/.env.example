# Copy to apps/web/.env.local (dev) and set the same names in Vercel project env (prod).
# New Supabase project only; apply 002_compete.sql, then 003_audit_hardening.sql.
VITE_SUPABASE_URL=
# Prefer the publishable key. A legacy anon key remains supported below.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
# Hosted AI is intentionally disabled for this youth-facing app. Local coaching needs no key.
